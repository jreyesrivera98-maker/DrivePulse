# Copia este archivo a .env.local y completa con los valores de tu proyecto
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# La service_role key NUNCA va aquí (con prefijo VITE_ se expone al navegador).
# Se usa únicamente dentro de supabase/functions/* (Edge Functions).
